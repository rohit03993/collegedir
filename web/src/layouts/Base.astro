---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { brandState } from '../lib/brand';

interface Props {
  title: string;
  description?: string;
  query?: string;
  menu?: boolean;
}

const {
  title,
  description = 'Search colleges, courses, and places on Admission Setu.',
  query = '',
  menu = true,
} = Astro.props;

const explore = [
  ['Colleges', '/colleges'],
  ['Courses', '/courses'],
  ['Exams', '/exams'],
  ['Scholarships', '/scholarships'],
  ['News', '/news'],
  ['Setu Predictor', '/predictor'],
];
const streams = [
  ['Engineering', 'Engineering'],
  ['Medical', 'Medical'],
  ['Management', 'Management'],
  ['Law', 'Law'],
  ['Science', 'Science'],
  ['Design', 'Design'],
];
const states = ['Uttar Pradesh', 'Delhi', 'Maharashtra', 'Karnataka', 'Tamil Nadu', 'Rajasthan', 'Gujarat', 'Bihar', 'Punjab', 'Madhya Pradesh'];
const exams = ['JEE Main', 'JEE Advanced', 'NEET', 'CUET', 'CAT', 'CLAT', 'GATE'];
const path = Astro.url.pathname;
const signedIn = Boolean(Astro.cookies.get('setu_staff')?.value);
const brand = brandState();
const menuLinks = [
  ['Colleges', '/colleges'],
  ['Setu Predictor', '/predictor'],
  ['Exams', '/exams'],
  ['Courses', '/courses'],
  ['Scholarships', '/scholarships'],
  ['News', '/news'],
];

function current(href: string) {
  return path === href || path.startsWith(`${href}/`);
}

function collegeLinks(stream: string) {
  const links = [[`Top ${stream} colleges in India`, `/colleges?stream=${encodeURIComponent(stream)}`]];
  for (const state of states) {
    links.push([
      `${stream} colleges in ${state}`,
      `/colleges?stream=${encodeURIComponent(stream)}&state=${encodeURIComponent(state)}`,
    ]);
  }
  return links;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type={brand.faviconType} href={brand.favicon} />
    {brand.logo && <link rel="apple-touch-icon" href={brand.logo} />}
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-3 py-2.5 sm:flex-row sm:items-center sm:gap-3 sm:px-4 sm:py-3">
        <div class="flex min-w-0 items-center justify-between gap-3 sm:contents">
          <a href="/" class="min-w-0 shrink" aria-label="Admission Setu">
            <Mark logo={brand.logo} compact short large />
          </a>
          <a
            href={signedIn ? '/admin' : '/admin/login'}
            class="inline-flex h-10 shrink-0 items-center rounded-full bg-slate-900 px-3.5 text-sm font-semibold text-white hover:bg-slate-800 sm:hidden"
          >{signedIn ? 'Admin' : 'Sign in'}</a>
        </div>
        {
          menu && (
            <nav class="ml-2 hidden items-center gap-1 xl:flex" aria-label="Main">
              {menuLinks.map(([label, href]) => (
                <a
                  href={href}
                  class:list={[
                    'rounded-full px-3 py-1.5 text-sm font-semibold',
                    current(href) ? 'bg-orange-50 text-orange-600' : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900',
                  ]}
                >{label}</a>
              ))}
            </nav>
          )
        }
        <form action="/colleges" method="get" class="min-w-0 flex-1" role="search">
          <label class="sr-only" for="nav-search">Search colleges, courses, cities, or states</label>
          <input
            id="nav-search"
            type="search"
            name="q"
            value={query}
            placeholder="Search colleges"
            class="h-10 w-full min-w-0 rounded-full border border-slate-200 bg-slate-50 px-4 text-sm outline-none focus:border-orange-400 focus:bg-white"
          />
        </form>
        <a
          href={signedIn ? '/admin' : '/admin/login'}
          class="hidden h-10 shrink-0 items-center rounded-full bg-slate-900 px-3.5 text-sm font-semibold text-white hover:bg-slate-800 sm:inline-flex sm:px-4"
        >{signedIn ? 'Admin' : 'Sign in'}</a>
      </div>
      {
        menu && (
          <nav class="border-t border-slate-100 xl:hidden" aria-label="Sections">
            <div class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-3 py-2 [scrollbar-width:none] sm:px-4 [&::-webkit-scrollbar]:hidden">
              {menuLinks.map(([label, href]) => (
                <a
                  href={href}
                  class:list={[
                    'shrink-0 rounded-full px-3 py-1.5 text-sm font-semibold',
                    current(href) ? 'bg-orange-500 text-white' : 'text-slate-700 hover:bg-slate-50',
                  ]}
                >{label}</a>
              ))}
            </div>
          </nav>
        )
      }
    </header>
    <slot />
    <footer class="mt-16 bg-slate-950 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div class="sm:col-span-2 lg:col-span-1">
          <a href="/" class="text-xl" aria-label="Admission Setu"><Mark logo={brand.logo} light /></a>
          <p class="mt-3 max-w-xs text-sm leading-6 text-slate-400">Find a college, course, or exam. Setu Predictor uses the official 2026 JoSAA and CSAB closing ranks.</p>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Explore</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {explore.map(([label, href]) => (
              <li><a href={href} class="hover:text-white">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Streams</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {streams.map(([label, stream]) => (
              <li><a href={`/colleges?stream=${encodeURIComponent(stream)}`} class="hover:text-white">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Entrance exams</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {exams.map((name) => (
              <li><a href={`/exams?q=${encodeURIComponent(name)}`} class="hover:text-white">{name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-800">
        <div class="mx-auto max-w-6xl px-4 py-12">
          <h2 class="text-lg font-bold text-white">Explore by interest</h2>
          <p class="mt-1 text-sm text-slate-400">Open a college list for a stream and a state.</p>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <h3 class="text-sm font-semibold text-white">Engineering colleges</h3>
              <ul class="mt-3 space-y-2 text-sm">
                {collegeLinks('Engineering').map(([label, href]) => (
                  <li><a href={href} class="hover:text-white">{label}</a></li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-white">Management colleges</h3>
              <ul class="mt-3 space-y-2 text-sm">
                {collegeLinks('Management').map(([label, href]) => (
                  <li><a href={href} class="hover:text-white">{label}</a></li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-white">Medical colleges</h3>
              <ul class="mt-3 space-y-2 text-sm">
                {collegeLinks('Medical').map(([label, href]) => (
                  <li><a href={href} class="hover:text-white">{label}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
