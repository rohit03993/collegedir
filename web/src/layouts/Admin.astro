---
import '../styles/global.css';
import Favicon from '../components/Favicon.astro';
import Mark from '../components/Mark.astro';
import { brandState } from '../lib/brand';

interface Props {
  title: string;
  user: { name: string; role: string };
  section: 'dashboard' | 'colleges' | 'team' | 'brand';
}

const { title, user, section } = Astro.props;
const brand = brandState();
const links = [
  ['dashboard', '/admin', 'Dashboard'],
  ['colleges', '/admin/colleges', 'Colleges'],
];
if (user.role === 'admin') {
  links.push(['brand', '/admin/brand', 'Brand']);
  links.push(['team', '/admin/users', 'Team']);
}
const item = 'flex items-center rounded-xl px-3 py-2 text-sm font-semibold';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Favicon />
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <div class="lg:grid lg:grid-cols-[240px_1fr]">
      <aside class="bg-slate-950 text-slate-300 lg:min-h-screen">
        <div class="flex items-center justify-between gap-3 px-4 py-4 lg:block">
          <a href="/admin" aria-label="Admission Setu"><Mark logo={brand.logo} light /></a>
          <p class="mt-1 hidden text-xs text-slate-500 lg:block">Admin</p>
        </div>
        <nav class="flex gap-1 overflow-x-auto px-3 pb-3 lg:block lg:space-y-1 lg:px-3">
          {links.map(([key, href, label]) => (
            <a href={href} class:list={[item, section === key ? 'bg-orange-500 text-white' : 'hover:bg-slate-900 hover:text-white']}>{label}</a>
          ))}
        </nav>
      </aside>
      <div class="min-w-0">
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:px-6">
          <p class="text-sm text-slate-600"><span class="font-semibold text-slate-900">{user.name}</span> · {user.role === 'admin' ? 'Admin' : 'Editor'}</p>
          <form method="post" action="/admin/logout">
            <button type="submit" class="rounded-full border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:border-orange-300">Sign out</button>
          </form>
        </header>
        <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
