---
interface Props {
  logo?: string;
  light?: boolean;
  compact?: boolean;
  short?: boolean;
  large?: boolean;
}

const { logo = '', light = false, compact = false, short = false, large = false } = Astro.props;
---

{
  logo && !light ? (
    <img
      src={logo}
      alt="Admission Setu"
      class:list={[
        'w-auto object-contain object-left',
        large ? 'h-14 w-auto max-w-full object-center xl:max-w-[16rem] xl:object-left' : 'h-12 max-w-[14rem]',
      ]}
    />
  ) : (
    <span class:list={['truncate font-black tracking-tight', compact ? 'text-base sm:text-lg' : 'text-lg', light ? 'text-white' : 'text-slate-900']}>
      <span class:list={[short && 'hidden sm:inline']}>Admission</span><span class="text-orange-500">Setu</span>
    </span>
  )
}
