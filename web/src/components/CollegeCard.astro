---
import type { CollegeCardData } from '../lib/types';

interface Props {
  college: CollegeCardData;
}

const { college } = Astro.props;
const place = [college.city, college.state].filter(Boolean).join(', ');
const showRank = college.openingRank || college.closingRank || college.chance;
---

<a
  href={`/colleges/${encodeURIComponent(college.slug)}`}
  class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-orange-300"
>
  <div class="relative aspect-[16/10] w-full bg-slate-100">
    {
      college.image && (
        <img src={college.image} alt="" class="h-full w-full object-cover" loading="lazy" onerror="this.remove()" />
      )
    }
    {
      college.ownership && (
        <span class="absolute left-3 top-3 rounded-full bg-slate-900/75 px-2.5 py-0.5 text-xs font-semibold text-white">{college.ownership}</span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h2 class="line-clamp-2 text-base font-semibold text-slate-900">{college.name}</h2>
    {place && <p class="text-sm text-slate-600">{place}</p>}
    {college.courseGroup && <p class="text-sm font-medium text-slate-800">{college.courseGroup}</p>}
    {college.fee && <p class="text-sm text-slate-800">{college.fee}</p>}
    {
      college.rating != null && (
        <p class="text-sm font-semibold text-orange-600">Rating {college.rating.toFixed(1)}</p>
      )
    }
    {
      showRank && (
        <dl class="mt-3 grid grid-cols-3 gap-2 border-t border-slate-100 pt-3 text-xs">
          {college.openingRank && (
            <div>
              <dt class="text-slate-500">Opening rank</dt>
              <dd class="font-semibold text-slate-900">{college.openingRank}</dd>
            </div>
          )}
          {college.closingRank && (
            <div>
              <dt class="text-slate-500">Closing rank</dt>
              <dd class="font-semibold text-slate-900">{college.closingRank}</dd>
            </div>
          )}
          {college.chance && (
            <div>
              <dt class="text-slate-500">Chance</dt>
              <dd class="font-semibold text-slate-900">{college.chance}</dd>
            </div>
          )}
        </dl>
      )
    }
  </div>
</a>
