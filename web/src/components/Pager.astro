---
import { pageCount } from '../lib/paging';

interface Props {
  page: number;
  total: number;
  pageSize?: number;
  href: (page: number) => string;
}

const { page, total, pageSize = 20, href } = Astro.props;
const pages = pageCount(total, pageSize);
const current = Math.min(Math.max(page, 1), pages);
const number = new Intl.NumberFormat('en-IN');

const keep = new Set<number>([1, pages, current]);
for (const item of [current - 2, current - 1, current + 1, current + 2]) {
  if (item >= 1 && item <= pages) keep.add(item);
}
const sorted = [...keep].sort((left, right) => left - right);
const tokens: Array<number | 'gap'> = [];
let previous = 0;
for (const item of sorted) {
  if (previous && item - previous > 1) tokens.push('gap');
  tokens.push(item);
  previous = item;
}

const link = 'inline-flex h-10 min-w-10 items-center justify-center rounded-full border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-700 hover:border-orange-300';
const idle = 'inline-flex h-10 min-w-10 items-center justify-center rounded-full border border-slate-200 bg-slate-50 px-3 text-sm font-semibold text-slate-300';
---

{
  pages > 1 && (
    <nav class="mt-6" aria-label="Pages">
      <p class="mb-3 text-center text-sm text-slate-500">Page {number.format(current)} of {number.format(pages)}</p>
      <div class="flex flex-wrap items-center justify-between gap-3 sm:justify-center">
        {
          current > 1 ? (
            <a href={href(current - 1)} rel="prev" class={link}>Previous</a>
          ) : (
            <span class={idle} aria-disabled="true">Previous</span>
          )
        }
        {
          current < pages ? (
            <a href={href(current + 1)} rel="next" class={link}>Next</a>
          ) : (
            <span class={idle} aria-disabled="true">Next</span>
          )
        }
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1">
        {
          tokens.map((token) => {
            if (token === 'gap') return <span class="px-1 text-slate-400" aria-hidden="true">…</span>;
            const far = token !== 1 && token !== pages && Math.abs(token - current) > 1;
            if (token === current) {
              return (
                <span class:list={['inline-flex h-10 min-w-10 items-center justify-center rounded-full bg-orange-500 px-3 text-sm font-semibold text-white', far && 'hidden sm:inline-flex']} aria-current="page">
                  {token}
                </span>
              );
            }
            return (
              <a href={href(token)} class:list={[link, 'px-0', far && 'hidden sm:inline-flex']}>
                {token}
              </a>
            );
          })
        }
      </div>
    </nav>
  )
}
