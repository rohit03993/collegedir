---
interface Props {
  title: string;
  html: string | null;
}

const { title, html } = Astro.props;
---

{
  html && (
    <section class="rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
      <h2 class="text-xl font-bold">{title}</h2>
      <div class="prose-setu mt-3 text-[15px] text-slate-700" set:html={html} />
    </section>
  )
}
