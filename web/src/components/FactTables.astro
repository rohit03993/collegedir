---
import type { FactTable } from '../lib/types';

interface Props {
  tables: FactTable[];
}

const { tables } = Astro.props;
---

{
  tables.map((table) => (
    <div class="mt-6">
      {table.heading && <h3 class="text-base font-semibold text-slate-900">{table.heading}</h3>}
      <div class="mt-2 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead>
            <tr>
              {table.columns.map((column) => (
                <th class="whitespace-nowrap py-2 pr-4 font-medium text-slate-500">{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map((row) => (
              <tr class="border-t border-slate-100">
                {row.map((cell) => (
                  <td class="py-2 pr-4 align-top text-slate-800">{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))
}
