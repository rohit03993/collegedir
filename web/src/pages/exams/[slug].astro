---
import Base from '../../layouts/Base.astro';
import HtmlSection from '../../components/HtmlSection.astro';
import { ApiError, getExam } from '../../lib/api';
import type { ExamDetail } from '../../lib/types';
import { named, shownDate } from '../../lib/text';

const { slug } = Astro.params;
let exam: ExamDetail | null = null;
let error = '';
let status = 200;
try {
  exam = await getExam(slug || '');
} catch (err) {
  status = err instanceof ApiError ? err.status : 503;
  error = err instanceof ApiError ? err.message : 'This exam page is unavailable.';
}
if (status !== 200) Astro.response.status = status;

const category = exam ? named(exam.category) : null;
const facts = exam ? [category, exam.level, exam.mode, shownDate(exam.date)].filter(Boolean) : [];
---

<Base title={exam ? `${exam.name} | Admission Setu` : 'Exam | Admission Setu'}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    {error && <p class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
    {
      exam && (
        <article class="space-y-8">
          <nav class="text-sm text-slate-500">
            <a href="/" class="hover:text-slate-800">Home</a>
            <span> / </span>
            <a href="/exams" class="hover:text-slate-800">Exams</a>
            <span> / </span>
            <span class="text-slate-800">{exam.name}</span>
          </nav>
          <header class="rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
            <h1 class="text-3xl font-black tracking-tight">{exam.name}</h1>
            {exam.fullName && exam.fullName !== exam.name && <p class="mt-2 text-slate-600">{exam.fullName}</p>}
            {facts.length > 0 && <p class="mt-3 text-sm text-slate-600">{facts.join(' · ')}</p>}
            {
              exam.officialWebsite && (
                <a href={exam.officialWebsite} class="mt-4 inline-flex text-sm font-semibold text-orange-600" rel="noopener noreferrer">Official website</a>
              )
            }
            {
              category && (
                <a href={`/colleges?stream=${encodeURIComponent(category)}`} class="mt-4 block text-sm font-semibold text-slate-700 hover:text-orange-600">
                  Colleges in {category}
                </a>
              )
            }
          </header>
          <HtmlSection title="Eligibility" html={exam.eligibility} />
          <HtmlSection title="Overview" html={exam.summaryHtml} />
          <HtmlSection title="About" html={exam.descriptionHtml} />
          <HtmlSection title="Pattern" html={exam.patternHtml} />
          <HtmlSection title="How to apply" html={exam.applicationHtml} />
          <HtmlSection title="Dates" html={exam.datesHtml} />
          <HtmlSection title="Result" html={exam.resultHtml} />
          {
            exam.faqs.length > 0 && (
              <section class="rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
                <h2 class="text-xl font-bold">Answers</h2>
                <div class="mt-4 space-y-5">
                  {exam.faqs.map((faq) => (
                    <div>
                      <h3 class="font-semibold text-slate-900">{faq.question}</h3>
                      <div class="prose-setu text-[15px] text-slate-700" set:html={faq.answer} />
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </article>
      )
    }
  </main>
</Base>
