---
import Base from '../../layouts/Base.astro';
import Pager from '../../components/Pager.astro';
import { ApiError, getArticles } from '../../lib/api';
import { PAGE_SIZE, pageCount, requestedPage, withPage } from '../../lib/paging';
import type { ArticleList } from '../../lib/types';

const query = (Astro.url.searchParams.get('q') || '').trim();
const page = requestedPage(Astro.url.searchParams.get('page'));
const params = new URLSearchParams();
if (query) params.set('q', query);
params.set('page', String(page));
params.set('per_page', String(PAGE_SIZE));

let list: ArticleList | null = null;
let error = '';
try {
  list = await getArticles(params);
} catch (err) {
  error = err instanceof ApiError ? err.message : 'The news list is unavailable.';
}
const total = list?.total || 0;
const shown = list?.items.length || 0;
const from = shown === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const to = shown === 0 ? 0 : from + shown - 1;
const number = new Intl.NumberFormat('en-IN');
const pageHref = (target: number) => withPage('/news', Astro.url.searchParams, target);
if (list && page > pageCount(total)) return Astro.redirect(pageHref(pageCount(total)));
---

<Base title="News | Admission Setu" query={query}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    <nav class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-800">Home</a>
      <span> / </span>
      <span class="text-slate-800">News</span>
    </nav>
    <h1 class="mt-3 text-3xl font-black tracking-tight">News</h1>
    {list && <p class="mt-1 text-sm text-slate-600">Showing {number.format(from)}–{number.format(to)} of {number.format(total)}</p>}
    {error && <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
    <form action="/news" method="get" class="mt-5" role="search">
      <label class="sr-only" for="news-search">Search news</label>
      <input id="news-search" type="search" name="q" value={query} placeholder="Search news" class="h-11 w-full rounded-full border border-slate-200 bg-white px-4 text-sm outline-none focus:border-orange-400" />
    </form>
    {
      list && list.items.length === 0 && total === 0 && (
        <p class="mt-6 rounded-2xl border border-slate-200 bg-white px-4 py-8 text-sm text-slate-600">No news matches this search.</p>
      )
    }
    <div class="mt-6 grid gap-3">
      {list?.items.map((article) => (
        <a href={`/news/${encodeURIComponent(article.slug)}`} class="rounded-2xl border border-slate-200 bg-white px-4 py-4 hover:border-orange-300">
          <h2 class="font-semibold text-slate-900">{article.title}</h2>
          {article.description && <p class="mt-2 line-clamp-2 text-sm text-slate-600">{article.description}</p>}
          {(article.category || article.author) && (
            <p class="mt-2 text-sm text-slate-500">{[article.category, article.author].filter(Boolean).join(' · ')}</p>
          )}
        </a>
      ))}
    </div>
    {list && total > 0 && <Pager page={page} total={total} href={pageHref} />}
  </main>
</Base>
