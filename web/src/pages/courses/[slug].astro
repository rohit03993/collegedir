---
import Base from '../../layouts/Base.astro';
import HtmlSection from '../../components/HtmlSection.astro';
import { ApiError, getCourse } from '../../lib/api';
import type { CourseDetail } from '../../lib/types';

const { slug } = Astro.params;
let course: CourseDetail | null = null;
let error = '';
let status = 200;
try {
  course = await getCourse(slug || '');
} catch (err) {
  status = err instanceof ApiError ? err.status : 503;
  error = err instanceof ApiError ? err.message : 'This course page is unavailable.';
}
if (status !== 200) Astro.response.status = status;
const facts = course ? [course.category, course.level, course.duration, course.mode].filter(Boolean) : [];
---

<Base title={course ? `${course.name} | Admission Setu` : 'Course | Admission Setu'}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    {error && <p class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
    {
      course && (
        <article class="space-y-8">
          <nav class="text-sm text-slate-500">
            <a href="/" class="hover:text-slate-800">Home</a>
            <span> / </span>
            <a href="/courses" class="hover:text-slate-800">Courses</a>
            <span> / </span>
            <span class="text-slate-800">{course.name}</span>
          </nav>
          <header class="rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
            <h1 class="text-3xl font-black tracking-tight">{course.name}</h1>
            {facts.length > 0 && <p class="mt-3 text-sm text-slate-600">{facts.join(' · ')}</p>}
            {course.summary && <p class="mt-4 text-sm leading-6 text-slate-700">{course.summary}</p>}
            {course.eligibility && <p class="mt-4 text-sm leading-6 text-slate-700">{course.eligibility}</p>}
            {
              course.category && (
                <a href={`/colleges?stream=${encodeURIComponent(course.category)}`} class="mt-4 inline-flex text-sm font-semibold text-orange-600">
                  Colleges in {course.category}
                </a>
              )
            }
          </header>
          <HtmlSection title="About" html={course.aboutHtml || course.descriptionHtml} />
          <HtmlSection title="Subjects" html={course.subjectsHtml} />
          <HtmlSection title="Admission" html={course.admissionHtml} />
          <HtmlSection title="Scope" html={course.scopeHtml} />
          {
            course.faqs.length > 0 && (
              <section class="rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
                <h2 class="text-xl font-bold">Answers</h2>
                <div class="mt-4 space-y-5">
                  {course.faqs.map((faq) => (
                    <div>
                      <h3 class="font-semibold text-slate-900">{faq.question}</h3>
                      <div class="prose-setu text-[15px] text-slate-700" set:html={faq.answer} />
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </article>
      )
    }
  </main>
</Base>
