---
import Base from '../../layouts/Base.astro';
import FactTables from '../../components/FactTables.astro';
import { ApiError, getCollege } from '../../lib/api';
import type { CollegeDetail, FactTable } from '../../lib/types';

const { slug } = Astro.params;
let college: CollegeDetail | null = null;
let error = '';
let status = 200;
try {
  college = await getCollege(slug || '');
} catch (err) {
  status = err instanceof ApiError ? err.status : 503;
  error = err instanceof ApiError ? err.message : 'This college page is unavailable.';
}
if (status !== 200) Astro.response.status = status;

const emptyFacts = {
  nirfRank: null,
  feeRange: null,
  averagePackage: null,
  approval: null,
  exams: null,
  courses: [] as FactTable[],
  admission: [] as FactTable[],
  placement: [] as FactTable[],
  cutoff: [] as FactTable[],
  scholarship: [] as FactTable[],
};
const facts = college?.facts || emptyFacts;
const sections = college
  ? [
      ['Overview', college.overviewHtml, [] as FactTable[]],
      ['Admission', college.admissionHtml, facts.admission],
      ['Cutoff', college.cutoffHtml, facts.cutoff],
      ['Placements', college.placementHtml, facts.placement],
      ['Facilities', college.facilitiesHtml, [] as FactTable[]],
      ['Hostel', college.hostelHtml, [] as FactTable[]],
      ['Scholarships', null, facts.scholarship],
    ].filter((entry): entry is [string, string | null, FactTable[]] => Boolean(entry[1]) || entry[2].length > 0)
  : [];
const banner = college?.image || college?.gallery[0] || null;
const gallery = college ? (college.image ? college.gallery : college.gallery.slice(1)) : [];
const preview = gallery.slice(0, 3);
const rest = gallery.slice(3);
const pageNav = college
  ? [
      sections.find(([title]) => title === 'Overview') ? ['overview', 'Overview'] : null,
      college.feesText || college.fees.length > 0 || facts.courses.length > 0 ? ['courses', 'Courses and fees'] : null,
      sections.find(([title]) => title === 'Admission') ? ['admission', 'Admission'] : null,
      sections.find(([title]) => title === 'Placements') ? ['placements', 'Placements'] : null,
      sections.find(([title]) => title === 'Cutoff') ? ['cutoff', 'Cutoff'] : null,
      sections.find(([title]) => title === 'Scholarships') ? ['scholarships', 'Scholarships'] : null,
      sections.find(([title]) => title === 'Facilities') ? ['facilities', 'Facilities'] : null,
      gallery.length > 0 ? ['gallery', 'Gallery'] : null,
      sections.find(([title]) => title === 'Hostel') ? ['hostel', 'Hostel'] : null,
      college.faqs.length > 0 ? ['answers', 'Answers'] : null,
    ].filter((item): item is [string, string] => Boolean(item))
  : [];
---

<Base title={college ? `${college.name} | Admission Setu` : 'College | Admission Setu'} menu={false}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    {
      error && (
        <p class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
      )
    }
    {
      college && (
        <article class="space-y-8">
          <nav class="text-sm text-slate-500">
            <a href="/" class="hover:text-slate-800">Home</a>
            <span> / </span>
            <a href="/colleges" class="hover:text-slate-800">Colleges</a>
            <span> / </span>
            <span class="text-slate-800">{college.name}</span>
          </nav>
          <header class="rounded-3xl border border-slate-200 bg-white">
            <div class="relative bg-slate-100">
              {
                banner && (
                  <img
                    src={banner}
                    alt=""
                    class="h-56 w-full rounded-t-3xl object-cover sm:h-72 md:h-80"
                    onerror="this.remove()"
                  />
                )
              }
              {
                !banner && <div class="h-40 rounded-t-3xl bg-slate-100" aria-hidden="true" />
              }
              {
                college.logo && (
                  <img
                    src={college.logo}
                    alt=""
                    class="absolute bottom-0 left-5 h-16 w-16 translate-y-1/2 rounded-2xl border-4 border-white bg-white object-contain p-1 shadow-sm md:left-8"
                    onerror="this.remove()"
                  />
                )
              }
            </div>
            <div class:list={['px-5 pb-6 md:px-8', college.logo ? 'pt-12' : 'pt-6']}>
              <h1 class="text-3xl font-black tracking-tight text-slate-900">{college.name}</h1>
              {
                (college.city || college.state || college.ownership || college.established) && (
                  <p class="mt-2 text-sm text-slate-600">
                    {college.city && college.state ? (
                      <a href={`/colleges?state=${encodeURIComponent(college.state)}&city=${encodeURIComponent(college.city)}`} class="hover:text-orange-600">
                        {college.city}, {college.state}
                      </a>
                    ) : (
                      college.city || college.state
                    )}
                    {college.ownership ? ` · ${college.ownership}` : ''}
                    {college.established ? ` · Est. ${college.established}` : ''}
                  </p>
                )
              }
              <div class="mt-3 flex flex-wrap gap-2">
                {college.rating != null && (
                  <span class="rounded-full bg-orange-50 px-3 py-1 text-sm font-semibold text-orange-700">
                    Rating {college.rating.toFixed(1)}
                  </span>
                )}
                {college.reviews != null && (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">{college.reviews} reviews</span>
                )}
                {college.category && (
                  <a href={`/colleges?stream=${encodeURIComponent(college.category)}`} class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">
                    {college.category}
                  </a>
                )}
                {facts.nirfRank != null && (
                  <span class="rounded-full bg-orange-500 px-3 py-1 text-sm font-semibold text-white">NIRF #{facts.nirfRank}</span>
                )}
                {facts.feeRange && (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">Fees {facts.feeRange}</span>
                )}
                {facts.averagePackage && (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">Avg package {facts.averagePackage}</span>
                )}
                {facts.exams && (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">{facts.exams}</span>
                )}
                {college.approvals.map((approval) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">{approval}</span>
                ))}
                {facts.approval && !college.approvals.includes(facts.approval) && (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">{facts.approval}</span>
                )}
                {college.tags.map((tag) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">{tag}</span>
                ))}
              </div>
            </div>
          </header>

          {
            pageNav.length > 1 && (
              <nav id="college-sections" class="sticky top-14 z-30 rounded-2xl border border-slate-200 bg-white px-3 py-2">
                <p class="college-stick-name mb-1 hidden truncate text-sm font-bold text-slate-900">{college.name}</p>
                <div class="flex gap-1 overflow-x-auto">
                  {pageNav.map(([id, label]) => (
                    <a href={`#${id}`} class="shrink-0 rounded-full px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-orange-50 hover:text-orange-700">{label}</a>
                  ))}
                </div>
              </nav>
            )
          }

          {
            gallery.length > 0 && (
              <section id="gallery" class="college-anchor rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
                <h2 class="text-xl font-bold">Campus gallery</h2>
                <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {preview.map((photo) => (
                    <img src={photo} alt="" class="aspect-[16/10] w-full rounded-2xl bg-slate-100 object-cover" loading="lazy" onerror="this.remove()" />
                  ))}
                </div>
                {
                  rest.length > 0 && (
                    <details class="mt-4">
                      <summary class="cursor-pointer text-center text-sm font-semibold text-slate-700">
                        View all {gallery.length} photos
                      </summary>
                      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {rest.map((photo) => (
                          <img src={photo} alt="" class="aspect-[16/10] w-full rounded-2xl bg-slate-100 object-cover" loading="lazy" onerror="this.remove()" />
                        ))}
                      </div>
                    </details>
                  )
                }
              </section>
            )
          }

          {
            sections.map(([title, html, tables]) => (
              <section id={title === 'Scholarships' ? 'scholarships' : title.toLowerCase()} class="college-anchor rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
                <h2 class="text-xl font-bold">{title}</h2>
                {title === 'Cutoff' && tables.length > 0 && (
                  <p class="mt-2 text-sm text-slate-500">Published closing ranks and scores. This is not a prediction.</p>
                )}
                {title === 'Cutoff' && tables.length === 0 && (
                  <p class="mt-2 text-sm text-slate-500">This is the catalogue note, not a rank result.</p>
                )}
                {html && <div class="prose-setu mt-3 text-[15px] text-slate-700" set:html={html} />}
                <FactTables tables={tables} />
              </section>
            ))
          }

          {
            (college.feesText || college.fees.length > 0 || facts.courses.length > 0) && (
              <section id="courses" class="college-anchor rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
                <h2 class="text-xl font-bold">Courses and fees</h2>
                {college.feesText && <p class="mt-3 text-sm text-slate-700">{college.feesText}</p>}
                <FactTables tables={facts.courses} />
                {
                  college.fees.length > 0 && (
                    <div class="mt-4">
                      <table class="w-full text-left text-sm">
                        <thead class="text-slate-500">
                          <tr>
                            <th class="py-2 pr-4 font-medium">Course</th>
                            <th class="py-2 pr-4 font-medium">Duration</th>
                            <th class="py-2 font-medium">Fee</th>
                          </tr>
                        </thead>
                        <tbody>
                          {college.fees.map((fee) => (
                            <tr class="border-t border-slate-100">
                              <td class="py-3 pr-4">
                                <p class="font-medium text-slate-900">{fee.courseName || fee.courseGroup}</p>
                                {fee.courseGroup && fee.courseName && (
                                  <p class="text-slate-500">{fee.courseGroup}</p>
                                )}
                                {fee.specialization && <p class="text-slate-500">{fee.specialization}</p>}
                                {fee.year && <p class="text-slate-500">{fee.year}</p>}
                              </td>
                              <td class="py-3 pr-4 text-slate-700">{fee.duration}</td>
                              <td class="py-3 text-slate-800">{fee.fee}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )
                }
              </section>
            )
          }

          {
            college.faqs.length > 0 && (
              <section id="answers" class="college-anchor rounded-3xl border border-slate-200 bg-white p-5 md:p-8">
                <h2 class="text-xl font-bold">Answers</h2>
                <div class="mt-4 space-y-5">
                  {college.faqs.map((faq) => (
                    <div>
                      <h3 class="font-semibold text-slate-900">{faq.question}</h3>
                      <div class="prose-setu text-[15px] text-slate-700" set:html={faq.answer} />
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </article>
      )
    }
  </main>
  <script is:inline>
    const bar = document.getElementById('college-sections');
    if (bar) {
      const links = Array.prototype.slice.call(bar.querySelectorAll('a[href^="#"]'));
      const sections = links.map(function (link) {
        return document.getElementById(link.getAttribute('href').slice(1));
      }).filter(Boolean);
      const mark = function () {
        const stuck = bar.getBoundingClientRect().top <= 58;
        bar.classList.toggle('is-stuck', stuck);
        const line = Math.max(bar.getBoundingClientRect().bottom + 12, window.innerHeight * 0.28);
        let current = sections[0];
        sections.forEach(function (section) {
          if (section.getBoundingClientRect().top <= line) current = section;
        });
        links.forEach(function (link) {
          link.classList.toggle('is-current', current && link.getAttribute('href') === '#' + current.id);
        });
      };
      document.addEventListener('scroll', mark, { passive: true });
      mark();
    }
  </script>
</Base>
