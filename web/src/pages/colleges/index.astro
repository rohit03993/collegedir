---
import Base from '../../layouts/Base.astro';
import CollegeCard from '../../components/CollegeCard.astro';
import Filters from '../../components/Filters.astro';
import Pager from '../../components/Pager.astro';
import { ApiError, getColleges } from '../../lib/api';
import { PAGE_SIZE, pageCount, requestedPage, withPage } from '../../lib/paging';
import type { CollegeList } from '../../lib/types';

const keys = ['state', 'city', 'course', 'branch', 'stream'] as const;
const selected = Object.fromEntries(keys.map((key) => [key, Astro.url.searchParams.getAll(key).map((value) => value.trim()).filter(Boolean)])) as Record<(typeof keys)[number], string[]>;
const query = (Astro.url.searchParams.get('q') || '').trim();
const page = requestedPage(Astro.url.searchParams.get('page'));

const params = new URLSearchParams();
if (query) params.set('q', query);
for (const key of keys) {
  for (const value of selected[key]) params.append(key, value);
}
params.set('page', String(page));
params.set('per_page', String(PAGE_SIZE));

let list: CollegeList | null = null;
let error = '';
try {
  list = await getColleges(params);
} catch (err) {
  error = err instanceof ApiError ? err.message : 'The college list is unavailable.';
}

const total = list?.total || 0;
const shown = list?.colleges.length || 0;
const from = shown === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const to = shown === 0 ? 0 : from + shown - 1;
const pageHref = (target: number) => withPage('/colleges', Astro.url.searchParams, target);
if (list && page > pageCount(total)) {
  return Astro.redirect(pageHref(pageCount(total)));
}
const number = new Intl.NumberFormat('en-IN');
const activeCount = keys.reduce((sum, key) => sum + selected[key].length, 0);
const streamLinks = [
  ['Engineering', 'Engineering'],
  ['Medical', 'Medical'],
  ['Management', 'Management'],
  ['Law', 'Law'],
  ['Science', 'Science'],
  ['Arts & Humanities', 'Arts'],
  ['Design', 'Design'],
  ['Education', 'Education'],
] as const;
const heading = selected.stream.length === 1 && selected.state.length === 1 && activeCount === 2
  ? `${selected.stream[0]} colleges in ${selected.state[0]}`
  : selected.stream.length === 1 && activeCount === 1
    ? `Top ${selected.stream[0]} colleges in India`
    : selected.state.length === 1 && activeCount === 1
      ? `Colleges in ${selected.state[0]}`
      : query
        ? `Colleges for “${query}”`
        : 'Colleges';
const clearFilters = query ? `/colleges?q=${encodeURIComponent(query)}` : '/colleges';

function dropFilter(dropKey: string, dropValue: string) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  for (const key of keys) {
    for (const value of selected[key]) {
      if (key === dropKey && value === dropValue) continue;
      params.append(key, value);
    }
  }
  const text = params.toString();
  return text ? `/colleges?${text}` : '/colleges';
}

---

<Base title={`${heading} | Admission Setu`} query={query}>
  <main class="mx-auto max-w-6xl px-4 pb-24 pt-8 lg:pb-8">
    <nav class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-800">Home</a>
      <span> / </span>
      <span class="text-slate-800">Colleges</span>
    </nav>
    <div class="mt-3 mb-6">
      <h1 class="text-3xl font-black tracking-tight text-slate-900">{heading}</h1>
      {
        list && total > 0 && (
          <p class="mt-1 text-sm text-slate-600">
            Showing {number.format(from)}–{number.format(to)} of {number.format(total)}
            {query ? ` for “${query}”` : ''}
          </p>
        )
      }
    </div>
    {error && <p class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
    <form action="/colleges" method="get" class="mb-4" role="search">
      {keys.flatMap((key) => selected[key].map((value) => <input type="hidden" name={key} value={value} />))}
      <label class="sr-only" for="list-search">Search colleges by name or city</label>
      <input
        id="list-search"
        type="search"
        name="q"
        value={query}
        placeholder="Search colleges by name or city"
        class="h-11 w-full rounded-full border border-slate-200 bg-white px-4 text-sm outline-none focus:border-orange-400"
      />
    </form>
    <div class="mb-4 flex flex-wrap gap-2">
      {streamLinks.map(([value, label]) => (
        <a
          href={`/colleges?stream=${encodeURIComponent(value)}`}
          class:list={[
            'rounded-full border px-3 py-1.5 text-sm',
            selected.stream.length === 1 && selected.stream[0] === value
              ? 'border-orange-500 bg-orange-50 font-semibold text-orange-700'
              : 'border-slate-200 bg-white text-slate-700',
          ]}
        >
          {label} Colleges
        </a>
      ))}
    </div>
    {
      activeCount > 0 && (
        <div class="mb-4 flex flex-wrap items-center gap-2">
          {keys.flatMap((key) => selected[key].map((value) => (
            <a href={dropFilter(key, value)} class="inline-flex items-center gap-1 rounded-full bg-orange-50 px-2.5 py-1 text-xs font-medium text-orange-700">
              {value}
              <span aria-hidden="true">×</span>
              <span class="sr-only">Remove {value}</span>
            </a>
          )))}
          <a href={clearFilters} class="text-xs font-semibold text-orange-600 hover:underline">Clear all</a>
        </div>
      )
    }
    <div class="page-grid relative">
      <input id="filter-open" type="checkbox" />
      <label for="filter-open" class="filter-launcher relative inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold shadow-lg">
        <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
          <path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        Filters
        {activeCount > 0 && (
          <span class="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-orange-500 px-1 text-[11px] font-bold text-white">{activeCount}</span>
        )}
      </label>
      <aside id="filter-panel" class="mb-6 lg:mb-0">
        <label for="filter-open" class="filter-backdrop" aria-label="Close filters"></label>
        <div class="filter-sheet">
          <div class="filter-sheet-bar">
            <span class="mx-auto h-1 w-10 rounded-full bg-slate-300" aria-hidden="true"></span>
            <label for="filter-open" class="absolute right-4 top-3 text-sm font-semibold text-slate-500">Close</label>
          </div>
          {
            list ? (
              <Filters query={query} selected={selected} facets={list.facets} />
            ) : (
              <p class="p-4 text-sm text-slate-600">Filters appear when the catalogue is available.</p>
            )
          }
        </div>
      </aside>
      <section class="min-w-0">
        {
          list && list.colleges.length === 0 && total === 0 && (
            <p class="rounded-2xl border border-slate-200 bg-white px-4 py-8 text-sm text-slate-600">
              {query && activeCount > 0
                ? `No colleges found for “${query}” with these filters.`
                : query
                  ? `No colleges found for “${query}”.`
                  : 'No colleges match these filters.'}
            </p>
          )
        }
        <div class="grid gap-4 sm:grid-cols-2">
          {list?.colleges.map((college) => <CollegeCard college={college} />)}
        </div>
        {list && total > 0 && <Pager page={page} total={total} href={pageHref} />}
      </section>
    </div>
  </main>
</Base>
