---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Admission Setu">
  <main class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-black">Page not found</h1>
    <p class="mt-3 text-slate-600">That page is not on Admission Setu.</p>
    <a href="/colleges" class="mt-6 inline-flex rounded-full bg-orange-500 px-5 py-2 text-sm font-semibold text-white">
      Browse colleges
    </a>
  </main>
</Base>
