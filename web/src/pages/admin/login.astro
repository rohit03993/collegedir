---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { brandState } from '../../lib/brand';
import { ApiError } from '../../lib/api';
import { adminFetch, saveSession, tokenFrom } from '../../lib/admin';

const token = tokenFrom(Astro.cookies);
if (token) {
  try {
    await adminFetch(token, '/api/admin/me');
    return Astro.redirect('/admin');
  } catch {
    // The old session is no longer valid.
  }
}

let setup = false;
let ready = true;
let error = '';
try {
  const status = await adminFetch<{ ready: boolean; setup: boolean }>(undefined, '/api/admin/status');
  ready = status.ready;
  setup = status.setup;
} catch (err) {
  ready = false;
  error = err instanceof ApiError ? err.message : 'The admin is unavailable.';
}

if (Astro.request.method === 'POST' && ready) {
  const form = await Astro.request.formData();
  const path = setup ? '/api/admin/setup' : '/api/admin/login';
  try {
    const result = await adminFetch<{ token: string }>(undefined, path, {
      method: 'POST',
      body: JSON.stringify({
        name: String(form.get('name') || ''),
        email: String(form.get('email') || ''),
        password: String(form.get('password') || ''),
      }),
    });
    saveSession(Astro.cookies, result.token);
    return Astro.redirect('/admin');
  } catch (err) {
    error = err instanceof ApiError ? err.message : 'Sign-in failed.';
  }
}

const field = 'h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-orange-400';
const brand = brandState();
---

<Base title={setup ? 'Create admin | Admission Setu' : 'Admin sign in | Admission Setu'}>
  <main class="mx-auto w-full max-w-md px-4 py-10 sm:py-16">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-2xl" aria-label="Admission Setu"><Mark logo={brand.logo} /></p>
        <h1 class="mt-6 text-xl font-bold">{setup ? 'Create the owner account' : 'Admin sign in'}</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          {setup
            ? 'This first account can edit colleges and add the rest of the team.'
            : 'Editors can update colleges. Admins can also add team accounts.'}
        </p>
        {error && <p class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
        {
          !ready && !error ? (
            <p class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">Apply db/admin.sql to admission_setu1, restart the API, then refresh this page.</p>
          ) : ready ? (
            <form method="post" class="mt-6 space-y-4">
              {setup && (
                <label class="block text-sm font-medium">
                  Name
                  <input name="name" required class:list={['mt-1', field]} />
                </label>
              )}
              <label class="block text-sm font-medium">
                Email
                <input type="email" name="email" required autocomplete="username" class:list={['mt-1', field]} />
              </label>
              <label class="block text-sm font-medium">
                Password
                <input type="password" name="password" required minlength="8" autocomplete={setup ? 'new-password' : 'current-password'} class:list={['mt-1', field]} />
              </label>
              <button type="submit" class="h-11 w-full rounded-xl bg-orange-500 font-semibold text-white">{setup ? 'Create account' : 'Sign in'}</button>
            </form>
          ) : null
        }
    </section>
  </main>
</Base>
