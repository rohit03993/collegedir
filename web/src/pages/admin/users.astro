---
import Admin from '../../layouts/Admin.astro';
import { ApiError } from '../../lib/api';
import { adminFetch, fieldClass, tokenFrom } from '../../lib/admin';

const token = tokenFrom(Astro.cookies);
if (!token) return Astro.redirect('/admin/login');

interface User { id?: number; name: string; email: string; role: string }
interface Account { id: number; email: string; name: string; role: string; active: boolean; created: string }

let me: User;
try {
  me = await adminFetch<User>(token, '/api/admin/me');
} catch {
  return Astro.redirect('/admin/login');
}
if (me.role !== 'admin') return Astro.redirect('/admin');

let error = '';
let saved = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');
  try {
    if (action === 'create') {
      await adminFetch(token, '/api/admin/staff', {
        method: 'POST',
        body: JSON.stringify({
          name: String(form.get('name') || ''),
          email: String(form.get('email') || ''),
          password: String(form.get('password') || ''),
          role: String(form.get('role') || ''),
        }),
      });
      saved = true;
    } else if (action === 'access') {
      await adminFetch(token, `/api/admin/staff/${encodeURIComponent(String(form.get('id') || ''))}`, {
        method: 'PATCH',
        body: JSON.stringify({ active: form.get('active') === '1' }),
      });
      saved = true;
    }
  } catch (err) {
    error = err instanceof ApiError ? err.message : 'The team change was not saved.';
  }
}

let items: Account[] = [];
try {
  const payload = await adminFetch<{ items: Account[] }>(token, '/api/admin/staff');
  items = payload.items;
} catch (err) {
  if (!error) error = err instanceof ApiError ? err.message : 'The team list is unavailable.';
}
---

<Admin title="Team | Admin" user={me} section="team">
  <h1 class="text-2xl font-black tracking-tight">Team</h1>
  <p class="mt-1 max-w-2xl text-sm text-slate-600">Admins can add people and turn access on or off. Editors can update colleges and cannot open this page.</p>
  {error && <p class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
  {saved && !error && <p class="mt-4 rounded-2xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Saved.</p>}
  <form method="post" class="mt-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-2">
    <input type="hidden" name="action" value="create" />
    <h2 class="text-lg font-bold sm:col-span-2">Add an account</h2>
    <label class="block text-sm font-medium">
      Name
      <input name="name" required class:list={['mt-1', fieldClass]} />
    </label>
    <label class="block text-sm font-medium">
      Email
      <input type="email" name="email" required class:list={['mt-1', fieldClass]} />
    </label>
    <label class="block text-sm font-medium">
      Password
      <input type="text" name="password" required minlength="8" autocomplete="off" class:list={['mt-1', fieldClass]} />
    </label>
    <label class="block text-sm font-medium">
      Access
      <select name="role" class:list={['mt-1', fieldClass]}>
        <option value="editor">Editor · colleges only</option>
        <option value="admin">Admin · colleges and team</option>
      </select>
    </label>
    <div class="sm:col-span-2">
      <button type="submit" class="h-11 rounded-xl bg-orange-500 px-4 text-sm font-semibold text-white">Create account</button>
    </div>
  </form>
  <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
    {items.map((account) => (
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 last:border-0">
        <div>
          <p class="font-semibold">{account.name}</p>
          <p class="text-sm text-slate-500">{account.email} · {account.role === 'admin' ? 'Admin' : 'Editor'} · {account.created}</p>
        </div>
        <form method="post">
          <input type="hidden" name="action" value="access" />
          <input type="hidden" name="id" value={String(account.id)} />
          <input type="hidden" name="active" value={account.active ? '0' : '1'} />
          <button type="submit" class="rounded-full border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-700">
            {account.active ? 'Turn off access' : 'Turn on access'}
          </button>
        </form>
      </div>
    ))}
  </div>
</Admin>
