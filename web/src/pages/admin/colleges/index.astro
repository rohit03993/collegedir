---
import Admin from '../../../layouts/Admin.astro';
import { adminFetch, fieldClass, tokenFrom } from '../../../lib/admin';

const token = tokenFrom(Astro.cookies);
if (!token) return Astro.redirect('/admin/login');

interface User { name: string; role: string }
interface Row {
  slug: string;
  name: string;
  city: string | null;
  state: string | null;
  category: string | null;
  type: string | null;
  active: boolean;
  nirf: number | null;
}
interface List {
  total: number;
  page: number;
  pageSize: number;
  q: string;
  state: string;
  city: string;
  category: string;
  status: string;
  sort: string;
  states: string[];
  categories: string[];
  items: Row[];
}

let user: User;
try {
  user = await adminFetch<User>(token, '/api/admin/me');
} catch {
  return Astro.redirect('/admin/login');
}

const params = Astro.url.searchParams;
const query = new URLSearchParams();
for (const key of ['q', 'state', 'city', 'category', 'status', 'sort', 'page']) {
  const value = (params.get(key) || '').trim();
  if (value) query.set(key, value);
}
let list: List | null = null;
let error = '';
try {
  const text = query.toString();
  list = await adminFetch<List>(token, `/api/admin/colleges${text ? `?${text}` : ''}`);
} catch (err) {
  error = err instanceof Error ? err.message : 'The college list is unavailable.';
}

const number = new Intl.NumberFormat('en-IN');
const page = list?.page || 1;
const pages = list ? Math.max(1, Math.ceil(list.total / list.pageSize)) : 1;

function hrefFor(target: number) {
  const next = new URLSearchParams(query);
  if (target > 1) next.set('page', String(target));
  else next.delete('page');
  const text = next.toString();
  return text ? `/admin/colleges?${text}` : '/admin/colleges';
}
---

<Admin title="Colleges | Admin" user={user} section="colleges">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Colleges</h1>
      {list && <p class="mt-1 text-sm text-slate-600">{number.format(list.total)} records, including hidden colleges.</p>}
    </div>
    <a href="/admin/colleges/new" class="inline-flex h-11 items-center rounded-xl bg-orange-500 px-4 text-sm font-semibold text-white">New college</a>
  </div>
  {error && <p class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
  {
    list && (
      <form method="get" class="mt-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-3">
        <label class="block text-sm font-medium sm:col-span-2 lg:col-span-3">
          Search name, slug, or city
          <input name="q" value={list.q} class:list={['mt-1', fieldClass]} />
        </label>
        <label class="block text-sm font-medium">
          State
          <select name="state" class:list={['mt-1', fieldClass]}>
            <option value="">All states</option>
            {list.states.map((state) => <option value={state} selected={state === list.state}>{state}</option>)}
          </select>
        </label>
        <label class="block text-sm font-medium">
          City
          <input name="city" value={list.city} class:list={['mt-1', fieldClass]} />
        </label>
        <label class="block text-sm font-medium">
          Stream
          <select name="category" class:list={['mt-1', fieldClass]}>
            <option value="">All streams</option>
            {list.categories.map((item) => <option value={item} selected={item === list.category}>{item}</option>)}
          </select>
        </label>
        <label class="block text-sm font-medium">
          Visibility
          <select name="status" class:list={['mt-1', fieldClass]}>
            <option value="all" selected={list.status === 'all'}>Shown and hidden</option>
            <option value="shown" selected={list.status === 'shown'}>Shown</option>
            <option value="hidden" selected={list.status === 'hidden'}>Hidden</option>
          </select>
        </label>
        <label class="block text-sm font-medium">
          Sort
          <select name="sort" class:list={['mt-1', fieldClass]}>
            <option value="name" selected={list.sort === 'name'}>Name</option>
            <option value="state" selected={list.sort === 'state'}>State</option>
            <option value="priority" selected={list.sort === 'priority'}>Priority</option>
            <option value="nirf" selected={list.sort === 'nirf'}>NIRF rank</option>
          </select>
        </label>
        <div class="flex items-end">
          <button type="submit" class="h-11 rounded-xl bg-slate-900 px-4 text-sm font-semibold text-white">Apply filters</button>
        </div>
      </form>
    )
  }
  {
    list && list.items.length === 0 && (
      <p class="mt-4 rounded-2xl border border-slate-200 bg-white px-4 py-8 text-sm text-slate-600">No colleges match these filters.</p>
    )
  }
  {
    list && list.items.length > 0 && (
      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <div class="divide-y divide-slate-100 md:hidden">
          {list.items.map((college) => (
            <a href={`/admin/colleges/${encodeURIComponent(college.slug)}`} class="block px-4 py-3">
              <span class="font-semibold">{college.name}</span>
              <span class="mt-1 block text-sm text-slate-500">{[college.city, college.state, college.category].filter(Boolean).join(' · ') || college.slug}</span>
              <span class="mt-1 block text-xs font-semibold text-slate-500">{college.active ? 'Shown' : 'Hidden'}{college.nirf != null ? ` · NIRF ${college.nirf}` : ''}</span>
            </a>
          ))}
        </div>
        <table class="hidden w-full text-left text-sm md:table">
          <thead class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-3 font-semibold">College</th>
              <th class="px-4 py-3 font-semibold">Place</th>
              <th class="px-4 py-3 font-semibold">Stream</th>
              <th class="px-4 py-3 font-semibold">NIRF</th>
              <th class="px-4 py-3 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody>
            {list.items.map((college) => (
              <tr class="border-b border-slate-100 last:border-0 hover:bg-orange-50/40">
                <td class="px-4 py-3">
                  <a href={`/admin/colleges/${encodeURIComponent(college.slug)}`} class="font-semibold text-slate-900 hover:text-orange-600">{college.name}</a>
                  <p class="text-xs text-slate-400">{college.slug}</p>
                </td>
                <td class="px-4 py-3 text-slate-600">{[college.city, college.state].filter(Boolean).join(', ') || '—'}</td>
                <td class="px-4 py-3 text-slate-600">{college.category || '—'}</td>
                <td class="px-4 py-3 text-slate-600">{college.nirf ?? '—'}</td>
                <td class="px-4 py-3">
                  <span class:list={['rounded-full px-2 py-0.5 text-xs font-semibold', college.active ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-600']}>{college.active ? 'Shown' : 'Hidden'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {
    list && pages > 1 && (
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
        <p class="text-slate-500">Page {number.format(page)} of {number.format(pages)}</p>
        <div class="flex gap-2">
          {page > 1 && <a href={hrefFor(page - 1)} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold">Previous</a>}
          {page < pages && <a href={hrefFor(page + 1)} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold">Next</a>}
        </div>
      </div>
    )
  }
</Admin>
